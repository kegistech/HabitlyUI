$RNFirebaseDisableSPM = true

# Resolve react_native_pods.rb with node to allow for hoisting
def node_require(script)
  require Pod::Executable.execute_command('node', [
    '-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )",
    __dir__
  ]).strip
end

node_require('react-native/scripts/react_native_pods.rb')

# ============================================
# REACT NATIVE PERMISSIONS SETUP (v4+)
# Dynamically resolves permissions setup script
# ============================================
node_require('react-native-permissions/scripts/setup.rb')

platform :ios, '15.1'
prepare_react_native_project!

# ============================================
# MODULAR HEADERS (Required for some RN modules)
# ============================================
use_modular_headers!

# ============================================
# FIREBASE REQUIRES STATIC FRAMEWORKS
# Do NOT use dynamic frameworks with Firebase
# ============================================
use_frameworks! :linkage => :static

target 'HabitlyUI' do
  config = use_native_modules!

  # ============================================
  # DECLARE REQUIRED PERMISSIONS HERE
  # Enables native iOS code for Notifications
  # ============================================
  setup_permissions([
    'Notifications',
  ])

  # ============================================
  # REACT NATIVE CORE
  # ============================================
  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # ============================================
  # FIREBASE PODS (REQUIRED for Push Notifications)
  # ============================================
  pod 'Firebase/Core'
  pod 'Firebase/Messaging'

  # ============================================
  # REACT NATIVE STORE REVIEW
  # Explicit path with modular headers for static framework compatibility
  # ============================================
  pod 'RNStoreReview', :path => '../node_modules/react-native-store-review', :modular_headers => true

  # ============================================
  # POST INSTALL HOOKS
  # ============================================
  post_install do |installer|
    # React Native post-install
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # ============================================
    # BUILD SETTINGS FIXES
    # ============================================
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Match platform target set at top of Podfile (15.1)
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        
        # Disable library distribution setting to allow Swift bridging header auto-generation
        config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
        
        # Fix for Xcode 15+ C++17 compatibility
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)', '_LIBCPP_ENABLE_CXX17_REMOVED_UNARY_BINARY_FUNCTION']
        
        # Swift module fixes for static linkage
        config.build_settings['DEFINES_MODULE'] = 'YES'
        config.build_settings['SWIFT_INSTALL_OBJC_HEADER'] = 'YES'
      end
    end

    # Project-level deployment target synchronization
    installer.pods_project.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
    end
  end
end